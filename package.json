{
  "name": "loom",
  "version": "0.1.0",
  "description": "Open-source change-impact intelligence for developers.",
  "type": "module",
  "private": true,
  "bin": {
    "loom": "dist/cli.js"
  },
  "workspaces": [
    "apps/dashboard"
  ],
  "engines": {
    "node": "22.23.3",
    "npm": ">=10.9.9"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:dashboard",
    "build:cli": "tsc -p tsconfig.build.json",
    "build:dashboard": "npm --workspace apps/dashboard run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --workspace apps/dashboard run typecheck",
    "test": "npm run typecheck && vitest run",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "vitest": "^5.0.5"
  }
}
