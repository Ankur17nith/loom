{
  "$schema": "https://json.schemastore.org/design-tokens",
  "name": "Loom Brand Identity Tokens",
  "version": "1.0.0",
  "description": "Canonical design tokens extracted from Figma Make Design Premium Logo Identity",
  "color": {
    "canvas": {
      "value": "#09090B",
      "type": "color",
      "description": "Primary near-black obsidian canvas"
    },
    "surface": {
      "base": { "value": "#111215", "type": "color" },
      "raised": { "value": "#18191E", "type": "color" },
      "strong": { "value": "#202227", "type": "color" },
      "hover": { "value": "#262830", "type": "color" },
      "selected": { "value": "#161b26", "type": "color" }
    },
    "border": {
      "line": { "value": "#27272A", "type": "color" },
      "lineSoft": { "value": "#1E1F24", "type": "color" },
      "lineHighlight": { "value": "rgba(255, 255, 255, 0.12)", "type": "color" }
    },
    "text": {
      "primary": { "value": "#F4F4F5", "type": "color" },
      "secondary": { "value": "#A1A1AA", "type": "color" },
      "tertiary": { "value": "#828A95", "type": "color" },
      "muted": { "value": "#5E6673", "type": "color" }
    },
    "brand": {
      "symbolWhite": { "value": "#F4F5F7", "type": "color", "description": "Crisp off-white front face of the geometric L" },
      "symbolWhiteFacet": { "value": "#606264", "type": "color", "description": "Chiseled 3D facet of the white L" },
      "blue": { "value": "#889CFF", "type": "color", "description": "Canonical cool blue/iris accent front face" },
      "blueFacet": { "value": "#3E406D", "type": "color", "description": "Shaded 3D facet of the blue accent" },
      "blueHover": { "value": "#A5B4FC", "type": "color" },
      "blueSoft": { "value": "rgba(136, 156, 255, 0.12)", "type": "color" },
      "blueBorder": { "value": "rgba(136, 156, 255, 0.35)", "type": "color" }
    },
    "semantic": {
      "success": { "value": "#34D399", "type": "color" },
      "warning": { "value": "#FBBF24", "type": "color" },
      "danger": { "value": "#F87171", "type": "color" },
      "info": { "value": "#889CFF", "type": "color" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "value": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif" },
      "mono": { "value": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace" }
    },
    "letterSpacing": {
      "tight": { "value": "-0.03em" },
      "normal": { "value": "-0.011em" }
    }
  },
  "geometry": {
    "symbol": {
      "grid": "7x7 modular grid with 9px units (63x63 active bounding box)",
      "stemWidth": 18,
      "baseHeight": 17,
      "counterGap": 8,
      "facetDepth": 9,
      "accentWidth": 27,
      "accentHeight": 36
    }
  }
}
